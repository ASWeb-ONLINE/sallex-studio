---
import { questions } from '../data/content';
---
<section id="faq" class="faq section" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div><p class="eyebrow">Вопросы и ответы</p><h2 id="faq-title">Несколько<br /> вопросов<br /> до старта<span class="accent">.</span></h2></div>
    <div class="faq__list">{questions.map((item, index) => <details><summary><span class="faq__number">0{index + 1}</span><span>{item.question}</span><span class="faq__icon" aria-hidden="true"></span></summary><div class="faq__answer"><p>{item.answer}</p></div></details>)}</div>
  </div>
</section>
