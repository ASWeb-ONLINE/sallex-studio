---
import '@fontsource-variable/oswald';
import '@fontsource-variable/golos-text';
import '../styles/global.css';
import { site, localPath } from '../data/site';

interface Props { title?: string; }
const { title = site.title } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL(localPath('social-preview.png'), Astro.site).href : undefined;
const revision = import.meta.env.PUBLIC_BUILD_SHA || 'local';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#EEECE8" />
    <meta name="build-revision" content={revision} />
    <link rel="icon" href={localPath('favicon.svg')} type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>
    <slot />
  </body>
</html>
